<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="520.0" spacing="12" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <Label text="Número da conta" />
    <TextField fx:id="numberField" promptText="Informe o número" />

    <Label fx:id="valueLabel" text="Valor" />
    <TextField fx:id="valueField" promptText="0,00" />

    <TextArea fx:id="resultArea" editable="false" prefHeight="250" />

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button fx:id="cancelButton" text="Cancelar" />
        <Button fx:id="actionButton" text="Confirmar" />
    </HBox>
</VBox>
