<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<GridPane fx:id="formGrid"
          xmlns="http://javafx.com/javafx/26"
          xmlns:fx="http://javafx.com/fxml/1"
          hgap="12"
          vgap="12"
          prefWidth="420">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
    <columnConstraints>
        <ColumnConstraints halignment="RIGHT" prefWidth="120"/>
        <ColumnConstraints hgrow="ALWAYS"/>
    </columnConstraints>

    <Label fx:id="idLabel" text="Conta:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <HBox fx:id="idRow" spacing="8" GridPane.rowIndex="0" GridPane.columnIndex="1">
        <TextField fx:id="idField" promptText="Número da conta" HBox.hgrow="ALWAYS"/>
        <Button fx:id="loadButton" text="Buscar"/>
    </HBox>

    <Label fx:id="numberLabel" text="Número:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <TextField fx:id="numberField" promptText="Número da conta"
               GridPane.rowIndex="2" GridPane.columnIndex="1"/>

    <Label fx:id="ownerLabel" text="Titular:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
    <TextField fx:id="ownerField" promptText="Nome do titular"
               GridPane.rowIndex="3" GridPane.columnIndex="1"/>

    <Label fx:id="balanceLabel" text="Saldo:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
    <TextField fx:id="balanceField" promptText="0,00"
               GridPane.rowIndex="4" GridPane.columnIndex="1"/>

    <HBox spacing="8"
          alignment="CENTER"
          GridPane.rowIndex="5"
          GridPane.columnIndex="0"
          GridPane.columnSpan="2">
        <Separator HBox.hgrow="ALWAYS"/>
        <Label text="Dados específicos"/>
        <Separator HBox.hgrow="ALWAYS"/>
    </HBox>

    <Label fx:id="typeLabel" text="Tipo:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
    <ComboBox fx:id="typeComboBox" maxWidth="Infinity"
              GridPane.rowIndex="6" GridPane.columnIndex="1"/>

    <Label fx:id="specificLabel" text="Limite:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
    <TextField fx:id="specificField" promptText="0,00"
               GridPane.rowIndex="7" GridPane.columnIndex="1"/>

    <HBox spacing="12" alignment="CENTER_RIGHT"
          GridPane.rowIndex="8" GridPane.columnIndex="1">
        <Button text="Cancelar" fx:id="cancelButton"/>
        <Button text="Salvar" fx:id="actionButton"/>
    </HBox>
</GridPane>
