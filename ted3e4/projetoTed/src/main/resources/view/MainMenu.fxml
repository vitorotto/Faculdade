<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.MainMenuController"
      alignment="CENTER"
      spacing="12"
      prefWidth="420"
      prefHeight="360">
    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <Label text="Cadastro de Contas" style="-fx-font-size: 22px; -fx-font-weight: bold;">
        <VBox.margin>
            <Insets bottom="20"/>
        </VBox.margin>
    </Label>

    <Button text="Incluir" onAction="#onIncluir" maxWidth="Infinity"/>
    <Button text="Consultar" onAction="#onConsultar" maxWidth="Infinity"/>
    <Button text="Alterar" onAction="#onAlterar" maxWidth="Infinity"/>
    <Button text="Excluir" onAction="#onExcluir" maxWidth="Infinity"/>
    <Button text="Depositar" onAction="#onDepositar" maxWidth="Infinity"/>
    <Button text="Sacar" onAction="#onSacar" maxWidth="Infinity"/>
    <Button text="Extrato" onAction="#onExtrato" maxWidth="Infinity"/>
    <Button text="Listar Contas" onAction="#onListar" maxWidth="Infinity"/>
</VBox>
